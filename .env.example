# Copy this to `.env` next to docker-compose.yml on your Coolify host.
# Coolify also lets you set these per-service in its UI.

# Public URL of the backend as seen by the browser. MUST include scheme + host.
# In Coolify this is the FQDN you assign to the backend service.
NEXT_PUBLIC_API_BASE_URL=https://couting.aaisee.me

# Public origin(s) allowed to call the API (comma separated).
# Frontend's own domain must be in this list, otherwise CORS will block it.
ALLOWED_ORIGINS=https://count.aaisee.me,https://couting.aaisee.me,http://localhost:3000

# Admin password required by POST /admin/reset-session.
# Change this to a strong secret in production!
ADMIN_PASSWORD=SuperAdmin2026

# GHCR repository (used by docker-compose to resolve image names).
GITHUB_REPOSITORY=vietlinhh02/countrealtime

# Optional: host port mapping
BACKEND_PORT=8000
FRONTEND_PORT=3000
